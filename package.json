{
  "name": "frontend-template",
  "version": "1.0.0",
  "description": "A frontend starter template with Vite, Bootstrap 5, and SCSS",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write \"src/**/*.{html,js,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{html,js,scss,json}\""
  },
  "keywords": [
    "template",
    "vite",
    "bootstrap",
    "scss",
    "frontend"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.7.6",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.9",
    "codemirror": "^6.0.2",
    "cron-parser": "^5.10.5",
    "cronstrue": "^3.39.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
